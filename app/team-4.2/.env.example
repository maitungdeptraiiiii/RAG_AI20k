# Copy thành .env (KHÔNG commit .env). Chỉ placeholder, không điền key thật ở đây.
OPENAI_API_KEY=
# Embedding: jina-* dùng Jina API (cần JINA_API_KEY); text-embedding-3-small (1536) dùng OpenAI.
# Đổi model thì phải index lại vào DATA_DIR mới.
EMBED_MODEL=jina-embeddings-v5-text-small
EMBED_DIM=1024
JINA_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=none        # gpt-6-luna chỉ nhận temperature mặc định
# Nếu LLM dùng endpoint/key riêng (OpenAI-compatible):
# LLM_BASE_URL=
# LLM_API_KEY=

MAX_SYLLABLES=300              # độ dài chunk (âm tiết)
ARM_K=20                       # số hit lấy từ mỗi arm (BM25, Dense)
RRF_K=60                       # hằng số k của RRF; thử 10/30/60 trên tập dev
BM25_RRF_WEIGHT=1.0           # Dense giữ trọng số 1; chỉ ảnh hưởng khi fusion nhiều arm
QUERY_REWRITE_ENABLED=false  # rewrite toàn câu cho Jev và BM25; Dense/câu con giữ nguyên
REWRITE_FOR_RERANK=true      # false: chỉ BM25 dùng rewrite; Jev dùng câu gốc
COVERAGE_ENABLED=false      # chọn top-k bằng Jev + độ phủ câu con, không gọi model thêm
COVERAGE_ANCHOR_K=2
COVERAGE_MIN_P=0.5
COVERAGE_WEIGHT=0.25
COVERAGE_BRANCH_K=5
LISTWISE_ENABLED=false     # chọn bằng LLM; dùng riêng với COVERAGE_ENABLED
LISTWISE_CANDIDATE_N=10
LISTWISE_MARGIN=0.05
LISTWISE_MIN_P=0.5
LISTWISE_EXCERPT_WORDS=300
DECOMP_ENABLED=false          # bật phân rã trước retrieval; không cần index lại
DECOMP_MAX_SUBQUERIES=3
DECOMP_INCLUDE_ORIGINAL=true
DECOMP_PER_QUERY_K=10          # số ứng viên/Điều mỗi câu, trước gộp giữa các câu
DECOMP_POOL_SIZE=30            # số ứng viên/Điều sau fusion đưa vào rerank
DECOMP_MAX_NEW_ARTICLES=10     # giữ nguyên pool câu gốc, chỉ thêm tối đa 10 Điều mới

# Phương pháp nâng cao (src/rag/advanced/), cách nhau dấu phẩy; để trống = baseline sprint 1.
#   hyde               arm Dense tìm bằng (câu hỏi + đoạn giả LLM viết) thay cho câu hỏi gốc; cùng index
#   contextual_header  thêm tên tài liệu + heading vào text index (không gọi LLM)
#   splade             arm SPLADE (vector thưa học được, mở rộng từ), gộp vào RRF; cần extra [neural]
#   colbert            arm ColBERT (MaxSim theo token), gộp vào RRF; cần extra [neural]
#   contextual         LLM viết bối cảnh cho từng chunk lúc ingest (Contextual Retrieval)
# Bật/tắt contextual* thì phải ingest lại vào DATA_DIR mới, vd. data/team-4.2/ablation/ctx (pipeline báo lỗi nếu trộn).
ADVANCED=
SPLADE_MODEL=naver/splade-cocondenser-ensembledistil   # bản tiếng Anh; đổi sang checkpoint đa ngữ/Việt
COLBERT_MODEL=colbert-ir/colbertv2.0                    # bản tiếng Anh; đổi sang checkpoint đa ngữ/Việt

RERANK_BACKEND=none            # none | jev
RERANK_N=20                    # số fused hit đưa vào rerank
TYPESAFE_API_KEY=              # chỉ cần khi RERANK_BACKEND=jev

TOP_K=5                        # cố định để chấm Recall@5/MRR@5; cũng là số đoạn context khi không rerank
CONTEXT_MIN_P=0.7              # ngưỡng xác suất Jev để đưa đoạn vào context (chọn trên tập dev)
CONTEXT_MAX_BLOCKS=8           # trần số đoạn context
CONTEXT_MAX_WORDS=2400         # trần độ dài context (từ/âm tiết)

# OCR cho PDF scan / ảnh (W02-02c): none | gemini.
# gemini = Gemini 3.5 Flash-Lite qua OpenRouter; ẢNH được gửi ra ngoài TRƯỚC khi mask PII
# -> chỉ bật cho tài liệu công khai. Tesseract (local) dùng để chấm confidence; thiếu thì bỏ qua bước này.
OCR_ENGINE=none
OCR_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OCR_COST_CAP_USD=1.0           # dừng OCR khi tổng chi phí (DATA_DIR/cache/ocr/cost_log.jsonl) vượt ngưỡng
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_MIN_CONFIDENCE=65          # Tesseract confidence < ngưỡng -> ocr.low_confidence (chọn trên split dev)

# Đường dẫn tính từ gốc repo (chạy mọi lệnh tại gốc agentic-batch-4)
DATA_DIR=data/team-4.2

# Think: chỉ bật qua nút Think / --think; không đổi baseline khi tắt.
AGENT_MAX_ROUNDS=3
AGENT_MAX_SEARCHES=8
AGENT_RETRIEVAL_MODE=dense
AGENT_INITIAL_SUBQUERIES=3
AGENT_FOLLOWUP_SEARCHES=2
AGENT_CANDIDATES_PER_SEARCH=10
AGENT_INITIAL_POOL_SIZE=30
AGENT_NEW_UNITS_PER_ROUND=10
AGENT_MAX_UNITS=50
AGENT_MAX_XREF_DEPTH=2
AGENT_XREFS_PER_ROUND=6
AGENT_MAX_XREF_TARGETS=12
AGENT_MAX_REQUIREMENTS=8
AGENT_MAX_MODEL_CALLS=24
AGENT_MAX_SERVICE_REQUESTS=240
AGENT_MAX_MODEL_BYTES=600000
AGENT_MAX_INPUT_CHARS=60000
AGENT_MAX_OUTPUT_TOKENS=3000
AGENT_DEADLINE_S=180

# Đồ thị hợp đồng (Neo4j, extra [graph]): CONTRACT_GRAPH=1 để bật. KHÔNG commit mật khẩu.
# Chạy Neo4j: docker compose -f docker/neo4j-compose.yml up -d (cần NEO4J_PASSWORD trong môi trường).
CONTRACT_GRAPH=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Đồ thị luật (Neo4j, cùng instance): LEGAL_GRAPH=1 để bật; dựng bằng `python -m rag.legal graph build`.
LEGAL_GRAPH=
