# Copy thành .env (KHÔNG commit .env). Chỉ placeholder, không điền key thật ở đây.
OPENAI_API_KEY=
# Embedding: chỉ cần đổi EMBED_MODEL. Model có sẵn trong src/rag/index/embedders/registry.py (KNOWN_MODELS):
#   jina-embeddings-v5-text-small        Jina API, 1024 chiều (cần JINA_API_KEY) — mặc định
#   text-embedding-3-small               OpenAI, 1536 chiều
#   bqbbao6/vietnamese-legal-embedding   local (HF, e5-base fine-tune luật VN), 768 chiều — cần extra [local]
#   AITeamVN/Vietnamese_Embedding        local (BGE-M3 fine-tune VN), 1024 chiều — cần extra [local]
# Model HF khác ("org/name") cũng chạy được ở backend local. Mỗi model có vector index riêng
# (DATA_DIR/indexes/vector/<model>/), lần chạy đầu tự embed lại chunks.jsonl — KHÔNG cần ingest lại.
EMBED_MODEL=jina-embeddings-v5-text-small
EMBED_DIM=                     # để trống = theo registry; chỉ đặt cho model API lạ
# EMBED_BACKEND=               # jina | openai | local | hash; để trống = tự đoán từ tên model
# EMBED_QUERY_PREFIX="query: " # ghi đè tiền tố (mặc định theo registry, vd. E5)
# EMBED_PASSAGE_PREFIX="passage: "
# EMBED_DEVICE=cuda            # local: để trống = tự chọn
# EMBED_BATCH_SIZE=32          # local
JINA_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=none        # gpt-6-luna chỉ nhận temperature mặc định
# Nếu LLM dùng endpoint/key riêng (OpenAI-compatible):
# LLM_BASE_URL=
# LLM_API_KEY=

MAX_SYLLABLES=300              # độ dài chunk (âm tiết)
ARM_K=20                       # số hit lấy từ mỗi arm (BM25, Dense)
RRF_K=60                       # hằng số k của RRF; thử 10/30/60 trên tập dev
RETRIEVAL_ARMS=                # arm của luồng chính, vd. "dense" = bỏ BM25; trống = mọi arm
# Cấu hình tốt nhất đã đo (11/2026): RETRIEVAL_ARMS=dense, ADVANCED=hyde, RERANK_BACKEND=jev

# Phương pháp nâng cao (src/rag/advanced/), cách nhau dấu phẩy; để trống = baseline sprint 1.
#   hyde               arm Dense tìm bằng (câu hỏi + đoạn giả LLM viết) thay cho câu hỏi gốc; cùng index
#   contextual_header  thêm tên tài liệu + heading vào text index (không gọi LLM)
#   splade             arm SPLADE (vector thưa học được, mở rộng từ), gộp vào RRF; cần extra [neural]
#   colbert            arm ColBERT (MaxSim theo token), gộp vào RRF; cần extra [neural]
#   contextual         LLM viết bối cảnh cho từng chunk lúc ingest (Contextual Retrieval)
# Bật/tắt contextual* thì phải ingest lại vào DATA_DIR mới, vd. data/team-4.2/ablation/ctx (pipeline báo lỗi nếu trộn).
ADVANCED=
SPLADE_MODEL=naver/splade-cocondenser-ensembledistil   # bản tiếng Anh; đổi sang checkpoint đa ngữ/Việt
COLBERT_MODEL=colbert-ir/colbertv2.0                    # bản tiếng Anh; đổi sang checkpoint đa ngữ/Việt

RERANK_BACKEND=none            # none | jev
RERANK_N=20                    # số fused hit đưa vào rerank
TYPESAFE_API_KEY=              # chỉ cần khi RERANK_BACKEND=jev

TOP_K=5                        # cố định để chấm Recall@5/MRR@5; cũng là số đoạn context khi không rerank
CONTEXT_MIN_P=0.7              # ngưỡng xác suất Jev để đưa đoạn vào context (chọn trên tập dev)
CONTEXT_MAX_BLOCKS=8           # trần số đoạn context
CONTEXT_MAX_WORDS=2400         # trần độ dài context (từ/âm tiết)

# Đường dẫn tính từ gốc repo (chạy mọi lệnh tại gốc agentic-batch-4)
DATA_DIR=data/team-4.2
